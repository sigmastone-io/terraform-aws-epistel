# Terraform's working files.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
tfplan
crash.log

# A deployment's own values and state are never committed. `deploy/config.example.yaml` shows the
# shape; the filled-in `deploy/config.yaml` stays on the machine that applies it.
deploy/config.yaml
*.tfvars
!*.tfvars.example

# Notes an operator keeps beside a deployment, such as the app passwords a first run prints.
# They belong in a password manager; this keeps a stray file out of a commit until it gets there.
passwords*.txt
*.secret
